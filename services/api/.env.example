# Copy to .env (optional). Everything works without any of these.
# DATABASE_URL=sqlite:///./argumente.db
# ANTHROPIC_API_KEY=sk-ant-...
# ENGINE_ANALYZE_MODEL=claude-sonnet-5-5
# ENGINE_FAST_MODEL=claude-haiku-5-5
# ENGINE_PROVIDER=auto   # auto | local | anthropic

# Sign-in
# ARGUMENTE_DEV=1                 # instant dev sign-in (scripts/dev.sh sets this; never on a real deployment)
# ADMIN_EMAILS=you@example.com    # comma-separated moderators
# WEB_ORIGIN=http://localhost:3000
# WEBAUTHN_RP_ID=localhost        # your domain in production, e.g. argumente.app
# SMTP_HOST=smtp.example.com      # without it, magic links are printed to the log
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# MAIL_FROM=Argumenté <no-reply@example.com>
